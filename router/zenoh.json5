{
  mode: "router",
  listen: {
    endpoints: ["tcp/0.0.0.0:7447"],
  },
  scouting: {
    multicast: {
      enabled: false,
    },
  },
  plugins_loading: {
    enabled: true,
    search_dirs: ["/zenoh-plugins"],
  },
  plugins: {
    remote_api: {
      __required__: true,
      websocket_port: "10000",
    },
  },
}
